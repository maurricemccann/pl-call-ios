<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Call listens to you while a call is open, so you can talk instead of type.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Call turns what you say into text on this iPhone, then sends the text to your session.</string>
	<key>NSMotionUsageDescription</key>
	<string>Call reads a nod or a shake of your head from your AirPods, so you can answer without your hands.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Call asks for Face ID when it opens, because it controls a live session.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>INStartCallIntent</string>
		<string>INStartAudioCallIntent</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Jost-400-Book.ttf</string>
		<string>Jost-500-Medium.ttf</string>
		<string>Jost-600-Semi.ttf</string>
		<string>Jost-700-Bold.ttf</string>
		<string>PLHand.ttf</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
